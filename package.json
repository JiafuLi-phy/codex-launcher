{
  "name": "codex-launcher",
  "version": "1.0.0",
  "description": "Codex 多模型启动器 - 在 Codex 中使用 DeepSeek/Qwen/GPT/Claude/Gemini",
  "author": "Codex Launcher Team <team@codexlauncher.app>",
  "homepage": "https://github.com/codex-launcher/codex-launcher",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "build:all": "electron-builder --mac --win --linux"
  },
  "build": {
    "appId": "com.codexlauncher.app",
    "productName": "Codex Launcher",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "proxy.js"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "icon.png"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "icon.png",
      "category": "Development"
    }
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "electron-updater": "^6.8.3"
  }
}
